# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Данные (большие файлы)
data/raw/*.csv
data/raw/*.xlsx
data/processed/*.csv
data/processed/*.parquet
