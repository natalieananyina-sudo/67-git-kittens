!data/processed/.gitkeep

# Модели (большие бинарники)
models/*.pkl
models/*.joblib
models/*.h5
models/*.onnx
!models/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Секреты
.env
*.key
secrets/

