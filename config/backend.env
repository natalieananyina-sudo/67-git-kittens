# Настройки бэкенда. Читаются автоматически:
#   * при запуске без Docker — модулем backend/app/config.py;
#   * в Docker Compose — через env_file (см. docker-compose.yml).
# Переменные окружения, заданные в системе, важнее значений из этого файла.

# ML-модуль (backend/ml, финальная модель anemia_hierarchical_rf_masked_v1):
#   auto  — финальная модель; если она не загрузилась, демо-резерв с предупреждением в интерфейсе;
#   model — только финальная модель (бэкенд не запустится, если её не удалось загрузить);
#   demo  — демо-резерв: классификатор заменён лабораторными критериями (для разработки интерфейса).
ML_MODE=auto

# Пути к ML-модулю и файлу модели (по умолчанию backend/ml и backend/ml/artifacts/models/final/pipeline.joblib)
# ML_PACKAGE_DIR=...
# ML_MODEL_PATH=...

# Показывать ли блок «Рекомендуемое лечение» из заключений медицинского эксперта.
# По концепции MVP сервис лечение не назначает, поэтому по умолчанию false.
INCLUDE_TREATMENT_HINTS=false

# Срок действия входа врача, секунд (8 часов)
TOKEN_TTL_SECONDS=28800

# Адреса фронтенда, которым разрешено обращаться к API напрямую (при работе через прокси не требуется)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Демо-учётная запись врача задана в коде (backend/app/config.py).
# Чтобы заменить её на стенде, раскомментируйте и укажите свои значения:
# DEMO_DOCTOR_LOGIN=doctor_demo
# DEMO_DOCTOR_PASSWORD=...

# Ключ подписи токенов. Для любого стенда, кроме локального демо, задайте свою длинную случайную строку:
# JWT_SECRET=...
